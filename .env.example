# =================================================================
# PAINTING SERVICE - DOCKER ENVIRONMENT VARIABLES CONFIGURATION
# =================================================================

# -----------------
# 1. DATABASE (MySQL 8)
# -----------------
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=paintingservice
MYSQL_USER=paintingservice_user
MYSQL_PASSWORD=paintingservice_password
MYSQL_PORT=3306

# -----------------
# 2. BACKEND (Spring Boot)
# -----------------
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:80
JWT_SIGNER_KEY=your_jwt_signer_key_here
JWT_EXPIRATION_MS=86400000

# Default Admin Seed Account
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=123456
DEFAULT_ADMIN_EMAIL=admin@suachua247.com
DEFAULT_ADMIN_PHONE=0987654321
DEFAULT_ADMIN_ADDRESS=Hà Nội

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# VNPay Payment Gateway
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost/customer/payment-callback

# -----------------
# 3. FRONTEND (React Vite & Nginx)
# -----------------
FRONTEND_PORT=80
VITE_MAPBOX_TOKEN=your_mapbox_token_here
VITE_API_URL=/api
